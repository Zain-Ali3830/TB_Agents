# Copy this file to .env and fill in your values
# Never commit .env to version control

# Target application
APP_URL=https://your-app.example.com
APP_ENV=staging

# Test user credentials
TEST_USER_EMAIL=testuser@example.com
TEST_USER_PASSWORD=

# Admin credentials (if needed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# API keys (if testing API layer)
API_BASE_URL=https://api.your-app.example.com
API_KEY=

# Browser config for Playwright
HEADLESS=true
SLOW_MO=0
BROWSER=chromium

# Figma (for design comparison)
FIGMA_TOKEN=
FIGMA_FILE_ID=
