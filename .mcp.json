{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "env": {
        "PLAYWRIGHT_HEADLESS": "${HEADLESS}",
        "PLAYWRIGHT_BROWSER": "${BROWSER}"
      }
    },
    "figma": {
      "command": "npx",
      "args": ["-y", "figma-developer-mcp", "--figma-api-key", "${FIGMA_TOKEN}"],
      "env": {
        "FIGMA_API_KEY": "${FIGMA_TOKEN}"
      }
    }
  }
}
